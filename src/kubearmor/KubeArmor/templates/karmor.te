########################################

type karmor_allow_nunn_t; # domain

type karmor_allow_nunn_exec_t; # parent process
type karmor_allow_nunn_allow_t; # child process
type karmor_allow_nunn_block_t; # child process

# kubearmor service -> assign karmor_allow_nunn_exec_t to a target
allow unconfined_service_t karmor_allow_nunn_exec_t:file { getattr relabelfrom relabelto };

# unconfined -> karmor_allow_nunn_exec_t
configure_domain(karmor_allow_nunn_t, karmor_allow_nunn_exec_t)
allow_process_execution(karmor_allow_nunn_t, karmor_allow_nunn_exec_t)

# kubearmor service -> assign karmor_allow_nunn_allow_t to a target
allow unconfined_service_t karmor_allow_nunn_allow_t:file { getattr relabelfrom relabelto };

# karmor_allow_nunn_t -> karmor_allow_nunn_allow_t
allow_child_process_execution(karmor_allow_nunn_t, karmor_allow_nunn_allow_t)
allow_file_access(unconfined_t, karmor_allow_nunn_allow_t)

# kubearmor service -> assign karmor_allow_nunn_block_t to a target
allow unconfined_service_t karmor_allow_nunn_block_t:file { getattr relabelfrom relabelto };

# karmor_allow_nunn_t -> karmor_allow_nunn_block_t
allow_no_child_process_execution(karmor_allow_nunn_t, karmor_allow_nunn_block_t)
allow_file_access(unconfined_t, karmor_allow_nunn_block_t)

type karmor_allow_nunn_read_t;
files_type(karmor_allow_nunn_read_t)

type karmor_allow_nunn_file_t;
files_type(karmor_allow_nunn_file_t)

type karmor_allow_nunn_none_t;
files_type(karmor_allow_nunn_none_t)

# kubearmor service -> assign karmor_allow_nunn_read_t to a target
allow unconfined_service_t karmor_allow_nunn_read_t:file { getattr relabelfrom relabelto };

# karmor_allow_nunn_t -> karmor_allow_nunn_read_t
allow_readonly_file_access(karmor_allow_nunn_t, karmor_allow_nunn_read_t)
allow_file_access(unconfined_t, karmor_allow_nunn_read_t)

# kubearmor service -> assign karmor_allow_nunn_file_t to a target
allow unconfined_service_t karmor_allow_nunn_file_t:file { getattr relabelfrom relabelto };

# karmor_allow_nunn_t -> karmor_allow_nunn_file_t
allow_file_access(karmor_allow_nunn_t, karmor_allow_nunn_file_t)
allow_file_access(unconfined_t, karmor_allow_nunn_file_t)

# kubearmor service -> assign karmor_allow_nunn_none_t to a target
allow unconfined_service_t karmor_allow_nunn_none_t:file { getattr relabelfrom relabelto };

# karmor_allow_nunn_t -> karmor_allow_nunn_none_t
allow_no_file_access(karmor_allow_nunn_t, karmor_allow_nunn_none_t)
allow_file_access(unconfined_t, karmor_allow_nunn_none_t)

# karmor_allow_nunn_t -> basic network operation
allow_common_network_operation(karmor_allow_nunn_t)

# karmor_allow_nunn_t -> per-protocol network operation

require {
    type user_devpts_t;
}

allow karmor_allow_nunn_t user_devpts_t:chr_file { append create execute getattr ioctl link lock mounton quotaon read relabelfrom relabelto rename setattr swapon unlink write audit_access entrypoint execute_no_trans execmod open };
allow_udp_network_operation(karmor_allow_nunn_t)

