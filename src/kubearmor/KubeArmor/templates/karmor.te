########################################

type karmor_allow_tnir_t; # domain

type karmor_allow_tnir_exec_t; # parent process
type karmor_allow_tnir_allow_t; # child process
type karmor_allow_tnir_block_t; # child process

# kubearmor service -> assign karmor_allow_tnir_exec_t to a target
allow unconfined_service_t karmor_allow_tnir_exec_t:file { getattr relabelfrom relabelto };

# unconfined -> karmor_allow_tnir_exec_t
configure_domain(karmor_allow_tnir_t, karmor_allow_tnir_exec_t)
allow_process_execution(karmor_allow_tnir_t, karmor_allow_tnir_exec_t)

# kubearmor service -> assign karmor_allow_tnir_allow_t to a target
allow unconfined_service_t karmor_allow_tnir_allow_t:file { getattr relabelfrom relabelto };

# karmor_allow_tnir_t -> karmor_allow_tnir_allow_t
allow_child_process_execution(karmor_allow_tnir_t, karmor_allow_tnir_allow_t)
allow_file_access(unconfined_t, karmor_allow_tnir_allow_t)

# kubearmor service -> assign karmor_allow_tnir_block_t to a target
