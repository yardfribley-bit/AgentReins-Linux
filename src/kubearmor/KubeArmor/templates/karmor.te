# karmor_allow_tnir_t -> karmor_allow_tnir_block_t
allow_no_child_process_execution(karmor_allow_tnir_t, karmor_allow_tnir_block_t)
allow_file_access(unconfined_t, karmor_allow_tnir_block_t)

type karmor_allow_tnir_read_t;
files_type(karmor_allow_tnir_read_t)

type karmor_allow_tnir_file_t;
files_type(karmor_allow_tnir_file_t)

type karmor_allow_tnir_none_t;
