# karmor_audit_tunr_t -> karmor_audit_tunr_file_t
allow_file_access(karmor_audit_tunr_t, karmor_audit_tunr_file_t)
allow_file_access(unconfined_t, karmor_audit_tunr_file_t)

# kubearmor service -> assign karmor_audit_tunr_none_t to a target
allow unconfined_service_t karmor_audit_tunr_none_t:file { getattr relabelfrom relabelto };

# karmor_audit_tunr_t -> karmor_audit_tunr_none_t
allow_no_file_access(karmor_audit_tunr_t, karmor_audit_tunr_none_t)
allow_file_access(unconfined_t, karmor_audit_tunr_none_t)

# karmor_audit_tunr_t -> basic network operation
allow_common_network_operation(karmor_audit_tunr_t)

# karmor_audit_tunr_t -> per-protocol network operation

require {
    type user_devpts_t;
}

allow karmor_audit_tunr_t user_devpts_t:chr_file { append create execute getattr ioctl link lock mounton quotaon read relabelfrom relabelto rename setattr swapon unlink write audit_access entrypoint execute_no_trans execmod open };
allow_tcp_network_operation(karmor_audit_tunr_t)
allow_udp_network_operation(karmor_audit_tunr_t)
allow_raw_network_operation(karmor_audit_tunr_t)

