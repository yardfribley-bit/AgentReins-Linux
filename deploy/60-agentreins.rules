-a always,exit -F arch=b64 -S execve,execveat -k agentreins_exec
-a always,exit -F arch=b32 -S execve,execveat -k agentreins_exec
-a always,exit -F arch=b64 -S connect,sendto -k agentreins_network
-a always,exit -F arch=b32 -S connect,sendto -k agentreins_network
-a always,exit -F arch=b64 -S unshare,setns,mount,umount2,pivot_root,chroot,capset,ptrace,setuid,setgid,setresuid,setresgid,seccomp,bpf -k agentreins_sandbox
-w /etc/passwd -p wa -k agentreins_files
-w /etc/group -p wa -k agentreins_files
-w /etc/sudoers -p wa -k agentreins_files
# Persistence writes (S08) are installed by runtime/watch_scope.py --apply.
# That command only adds audit watches for paths that already exist, with
# -p wa -k agentreins_persist. Do not add missing paths here: auditd refuses
# the whole file when a watched path is absent. Overlay upperdir changes are
# collected separately and do not cover volumes or bind mounts.
