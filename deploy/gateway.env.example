# Set to the actual provider's OpenAI-compatible base URL.
AGENTREINS_UPSTREAM=https://api.openai.com/v1
# Used only when agents.yaml does not set a bind address. Prefer per-agent ports.
AGENTREINS_BIND=127.0.0.1
AGENTREINS_GATEWAY_PORT=18900
# Route binding. Without this file the gateway still forwards /v1, but semantic
# events are marked unknown and the sensor does not admit them.
AGENTREINS_AGENTS=/etc/agentreins/agents.yaml
AGENTREINS_RUNTIME=/opt/agentreins-runtime
