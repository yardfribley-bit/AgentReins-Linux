[Unit]
Description=AgentReins Linux audit evidence bridge
After=auditd.service
Requires=auditd.service

[Service]
ExecStart=/usr/bin/python3 /opt/agentreins/audit_bridge.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/agentreins
ProtectHome=yes

[Install]
WantedBy=multi-user.target
