AGENTREINS_CONSOLE_BIND=127.0.0.1
AGENTREINS_CONSOLE_PORT=8899
# Comma-separated Docker container-name glob patterns; add other agents here.
AGENTREINS_WORKLOAD_PATTERNS=*pentagi*terminal*,*pentagi*kali*
# Optional extra container IDs, comma-separated.
AGENTREINS_WORKLOAD_IDS=
# Optional host directory mapped to /work for Nmap XML report reading.
AGENTREINS_REPORT_ROOT=
# Optional command marker identifying platform-initiated checks.
AGENTREINS_MANUAL_COMMAND_MARKER=
