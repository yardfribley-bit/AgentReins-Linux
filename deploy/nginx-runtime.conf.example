# Inside the existing HTTPS server. Backend binds loopback only.
location = /runtime { proxy_pass http://127.0.0.1:18920; proxy_set_header Host $host; }
location ^~ /runtime/ {
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:18920;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}
