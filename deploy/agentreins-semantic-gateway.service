[Unit]
Description=AgentReins OpenAI-compatible observation gateway
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/agentreins/gateway.env
ExecStart=/usr/bin/python3 /opt/agentreins/semantic_gateway.py
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
