{
  "database": "/var/lib/agentreins-runtime/runtime.sqlite",
  "operatorToken": "REPLACE_WITH_OPERATOR_TOKEN",
  "operatorName": "operator",
  "referees": {"judge": "REPLACE_WITH_REFEREE_TOKEN"},
  "drillFile": "/etc/agentreins-runtime/drill.yaml",
  "agentsFile": "/etc/agentreins/agents.yaml",
  "sources": {"host-01": "REPLACE_WITH_SOURCE_TOKEN"},
  "maxEvents": 200000,
  "maxEventsPerSource": 80000,
  "lossWindowSeconds": 900,
  "httpThresholds": {
    "distinctPaths": 20,
    "notFound": 20,
    "authFailures": 8,
    "errorRate": 0.5,
    "minSample": 30,
    "categoryHits": 3
  }
}
